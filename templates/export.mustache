{{!
    @template local_profilephoto/export

    Export filter screen (Entrega 4). No context variables of its own -
    all state is applied client-side by amd/src/export.js after render.
}}
<div class="local-profilephoto-export" data-region="lpp-export-app">

    <div class="lpp-export-filters">
        <label for="lpp-export-filtertype">{{#str}}export_filtertype, local_profilephoto{{/str}}</label>
        <select id="lpp-export-filtertype" class="form-control">
            <option value="session">{{#str}}export_filter_session, local_profilephoto{{/str}}</option>
            <option value="course">{{#str}}export_filter_course, local_profilephoto{{/str}}</option>
            <option value="cohort">{{#str}}export_filter_cohort, local_profilephoto{{/str}}</option>
        </select>

        <select id="lpp-export-session" class="form-control"></select>
        <select id="lpp-export-course" class="form-control" hidden></select>
        <select id="lpp-export-cohort" class="form-control" hidden></select>

        <label for="lpp-export-filenamestrategy">{{#str}}export_filenamestrategy, local_profilephoto{{/str}}</label>
        <select id="lpp-export-filenamestrategy" class="form-control">
            <option value="idnumber">idnumber</option>
            <option value="username">username</option>
            <option value="email">email</option>
            <option value="userid">userid</option>
            <option value="fullname">fullname</option>
        </select>

        <label for="lpp-export-type">{{#str}}export_filetype, local_profilephoto{{/str}}</label>
        <select id="lpp-export-type" class="form-control">
            <option value="zip">{{#str}}export_filetype_zip, local_profilephoto{{/str}}</option>
            <option value="orla">{{#str}}export_filetype_orla, local_profilephoto{{/str}}</option>
            <option value="grid6">{{#str}}export_filetype_grid6, local_profilephoto{{/str}}</option>
            <option value="directory">{{#str}}export_filetype_directory, local_profilephoto{{/str}}</option>
        </select>

        <label for="lpp-export-stage">{{#str}}export_stage, local_profilephoto{{/str}}</label>
        <select id="lpp-export-stage" class="form-control">
            <option value="fp">{{#str}}export_stage_fp, local_profilephoto{{/str}}</option>
            <option value="eso">{{#str}}export_stage_eso, local_profilephoto{{/str}}</option>
            <option value="batx">{{#str}}export_stage_batx, local_profilephoto{{/str}}</option>
        </select>

        <label for="lpp-export-language">{{#str}}export_language, local_profilephoto{{/str}}</label>
        <select id="lpp-export-language" class="form-control">
            <option value="ca">{{#str}}export_language_ca, local_profilephoto{{/str}}</option>
            <option value="es">{{#str}}export_language_es, local_profilephoto{{/str}}</option>
            <option value="en">{{#str}}export_language_en, local_profilephoto{{/str}}</option>
        </select>

        <label for="lpp-export-heading">{{#str}}export_heading, local_profilephoto{{/str}}</label>
        <input id="lpp-export-heading" class="form-control" type="text" placeholder="{{#str}}export_heading_placeholder, local_profilephoto{{/str}}">

        <button type="button" id="lpp-export-btn" class="btn btn-primary">
            {{#str}}export_generate, local_profilephoto{{/str}}
        </button>
    </div>

    <p id="lpp-export-status" class="lpp-export-status" role="status" aria-live="polite"></p>
</div>
