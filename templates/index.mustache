{{!
    @template local_profilephoto/index

    Main capture screen shell (Entrega 1: manual file-based capture; the
    camera panel arrives in Entrega 2 without changing this markup's ids,
    since amd/src/search.js and the future camera.js both bind to them).

    Context variables required by this template:
    * sesskey - current session key, for the manual-capture fallback form.
}}
<div class="local-profilephoto-app" data-region="lpp-app">

    <div class="lpp-searchbar">
        <label for="lpp-search-input" class="sr-only">{{#str}}search_label, local_profilephoto{{/str}}</label>
        <input type="text"
               id="lpp-search-input"
               class="form-control lpp-search-input"
               autocomplete="off"
               placeholder="{{#str}}search_placeholder, local_profilephoto{{/str}}">
        <div id="lpp-search-results" class="lpp-search-results" data-region="lpp-search-results"></div>
    </div>

    <div id="lpp-status" class="lpp-status" role="status" aria-live="polite"></div>

    <div class="lpp-layout">
        <div class="lpp-camera-zone" data-region="lpp-camera-zone">
            <p class="lpp-camera-placeholder text-muted">
                {{#str}}camera_comingsoon, local_profilephoto{{/str}}
            </p>

            <form id="lpp-manual-capture-form" class="lpp-manual-capture-form">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <label for="lpp-manual-file">{{#str}}manual_capture_label, local_profilephoto{{/str}}</label>
                <input type="file" id="lpp-manual-file" accept="image/jpeg,image/png">
                <img id="lpp-manual-preview" class="lpp-manual-preview" alt="" hidden>
                <button type="submit" id="lpp-save-btn" class="btn btn-primary" disabled>
                    {{#str}}save_and_next, local_profilephoto{{/str}}
                </button>
            </form>
        </div>

        <div class="lpp-student-zone" data-region="lpp-user-panel">
            <p class="lpp-no-selection text-muted">{{#str}}no_student_selected, local_profilephoto{{/str}}</p>
        </div>
    </div>
</div>
