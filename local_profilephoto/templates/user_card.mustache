{{!
    @template local_profilephoto/user_card

    Context variables required by this template:
    * id, fullname, email, idnumber, username, hasphoto, pictureurl, suspended, canupdate
}}
<div class="lpp-user-card" data-userid="{{id}}">
    <img src="{{pictureurl}}" alt="" class="lpp-user-card-avatar">
    <h3 class="lpp-user-card-name">{{fullname}}</h3>
    {{#idnumber}}<p class="lpp-user-card-meta">{{#str}}label_idnumber, local_profilephoto{{/str}}: {{idnumber}}</p>{{/idnumber}}
    {{#email}}<p class="lpp-user-card-meta">{{email}}</p>{{/email}}

    {{#suspended}}
    <p class="lpp-user-card-warning badge badge-secondary">{{#str}}badge_suspended, local_profilephoto{{/str}}</p>
    {{/suspended}}

    {{#hasphoto}}
    <p class="lpp-user-card-warning badge badge-warning">{{#str}}warning_hasphoto, local_profilephoto{{/str}}</p>
    {{/hasphoto}}

    {{^canupdate}}
    <p class="lpp-user-card-warning badge badge-danger">{{#str}}warning_cannotupdate, local_profilephoto{{/str}}</p>
    {{/canupdate}}
</div>
