{{!
    @template local_profilephoto/search_results

    Context variables required by this template:
    * hasusers - bool, true when there is at least one result
    * users - array of {id, fullname, email, idnumber, username, hasphoto, pictureurl, suspended}
}}
{{#hasusers}}
<ul class="list-unstyled lpp-result-list">
    {{#users}}
    <li>
        <button type="button" class="lpp-result-item" data-userid="{{id}}">
            <img src="{{pictureurl}}" alt="" class="lpp-result-avatar">
            <span class="lpp-result-info">
                <span class="lpp-result-name">{{fullname}}</span>
                {{#idnumber}}<span class="lpp-result-meta">{{idnumber}}</span>{{/idnumber}}
                {{#email}}<span class="lpp-result-meta">{{email}}</span>{{/email}}
            </span>
            {{#hasphoto}}
            <span class="badge badge-info">{{#str}}badge_hasphoto, local_profilephoto{{/str}}</span>
            {{/hasphoto}}
            {{#suspended}}
            <span class="badge badge-secondary">{{#str}}badge_suspended, local_profilephoto{{/str}}</span>
            {{/suspended}}
        </button>
    </li>
    {{/users}}
</ul>
{{/hasusers}}
{{^hasusers}}
<p class="lpp-no-results text-muted">{{#str}}search_noresults, local_profilephoto{{/str}}</p>
{{/hasusers}}
